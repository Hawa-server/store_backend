# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=store_db
DB_USER=
DB_PASSWORD=
# false locally; true in production (Aiven requires SSL)
DB_SSL=false
# Aiven's CA certificate contents (only when DB_SSL=true). Line breaks may be written as \n.
DB_CA_CERT=

# --- Proxies in front of the API (for real visitor IPs in rate limits) ---
# Production on Render behind the Vercel /api rewrite: 2 (Vercel + Render).
# 1 = Render only. Locally you can leave it out (defaults to 1).
TRUST_PROXY_HOPS=1

# --- Frontend address (the only origin CORS allows) ---
CLIENT_URL=http://localhost:5173

# --- Login tokens ---
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Paystack (test mode). Also used to check webhook signatures. ---
PAYSTACK_SECRET_KEY=

# --- ImageKit (optional: only for API image uploads, a stretch task that isn't built) ---
# Product photos are ImageKit URLs saved in the database by a seeder, so these can stay empty.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Email (Ethereal test SMTP: https://ethereal.email → Create Ethereal Account) ---
# Emails are caught, never delivered. Read them at ethereal.email (log in with
# SMTP_USER / SMTP_PASS). In development the server also prints a preview link.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Store <no-reply@store.test>"

# --- Store contact details (shown in order emails) ---
STORE_CONTACT_EMAIL=help@example.com
STORE_CONTACT_PHONE=0240000000

# --- Login code step (BE12) ---
# true: after the right password, a 6-digit code is emailed and must be entered
#       (POST /api/auth/login/verify-code). In development the code is also
#       printed in the server console.
# false: log in with the password only. Restart the server after changing it.
LOGIN_CODE_ENABLED=true

# --- Admin account created by the admin seeder ---
ADMIN_EMAIL=
# At least 8 characters
ADMIN_PASSWORD=
